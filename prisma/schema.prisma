generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("STUDENT") // STUDENT, ADMIN, MAINTENANCE
  roomNumber   String?
  complaints   Complaint[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // Plumbing, Electrical, Cleaning, etc.
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
